<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="700"
        Width="1100"
        Background="#F4F6F8">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Chat Area -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="10"
                Padding="10"
                Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox
                    Name="ChatDisplay"
                    IsReadOnly="True"
                    FontSize="14"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    Background="WhiteSmoke"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">

                    <TextBox
                        Name="UserInput"
                        Width="500"
                        Height="35"
                        FontSize="14"
                        KeyDown="UserInput_KeyDown"/>

                    <Button
                        Name="SendButton"
                        Width="100"
                        Height="35"
                        Margin="10,0,0,0"
                        Content="Send"
                        Click="SendButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Right Panel -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                Padding="10"
                Margin="5">

            <StackPanel>

                <TextBlock
                    Text="Task Manager"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,0,0,15"/>

                <ListBox
                    Name="TaskList"
                    Height="300"
                    Margin="0,0,0,15"/>

                <Button
                    Name="RefreshTasksButton"
                    Content="Refresh Tasks"
                    Height="35"
                    Margin="0,5"
                    Click="RefreshTasksButton_Click"/>

                <Button
                    Name="CompleteTaskButton"
                    Content="Complete Selected Task"
                    Height="35"
                    Margin="0,5"
                    Click="CompleteTaskButton_Click"/>

                <Button
                    Name="DeleteTaskButton"
                    Content="Delete Selected Task"
                    Height="35"
                    Margin="0,5"
                    Click="DeleteTaskButton_Click"/>

                <Button
                    Name="QuizButton"
                    Content="Start Quiz"
                    Height="35"
                    Margin="0,20,0,5"
                    Click="QuizButton_Click"/>

                <Button
                    Name="ActivityButton"
                    Content="Show Activity Log"
                    Height="35"
                    Margin="0,5"
                    Click="ActivityButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>